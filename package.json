{
  "name": "vite-plugin-effcss",
  "version": "1.0.0",
  "description": "Vite plugin for EffCSS — captures CSS via Vite SSR pipeline, injects into HTML",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "vite",
    "plugin",
    "vite-plugin",
    "effcss",
    "css",
    "css-in-ts",
    "css-in-js",
    "zero-config"
  ],
  "license": "Apache-2.0",
  "author": "Marat Sabitov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msabitov/vite-plugin-effcss.git"
  },
  "homepage": "https://github.com/msabitov/vite-plugin-effcss/",
  "bugs": {
    "url": "https://github.com/msabitov/vite-plugin-effcss/issues"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0",
    "effcss": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "effcss": "^5.4.0",
    "tsup": "^8.5.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.7"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --external vite --external effcss",
    "prepublishOnly": "npm run build"
  }
}
